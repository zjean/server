{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [
    ".*custom-mobile-compat/assets/.*"
  ],
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "target": "es2022"
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": true
}
